{
  "name": "seed-vault",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-vault-runtime.mjs",
    "dev": "vite",
    "build:vault-runtime": "node scripts/build-vault-runtime.mjs",
    "prebuild": "node scripts/build-vault-runtime.mjs",
    "build": "vite build",
    "build:standalone": "node scripts/build-vault-runtime.mjs && vite build --config vite.standalone.config.ts && node scripts/inline-dist.mjs",
    "postbuild": "node scripts/inline-dist.mjs",
    "preview": "vite preview",
    "test:unit": "vitest run --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:e2e:chromium": "playwright test --project=chromium --pass-with-no-tests",
    "test:node:cipher-roundtrip": "node scripts/verify-cipher-roundtrip.mjs"
  },
  "dependencies": {
    "argon2-browser": "^1.18.0",
    "@noble/ciphers": "^0.5.0",
    "@noble/curves": "^1.4.0",
    "@noble/hashes": "^1.4.0",
    "@noble/post-quantum": "^0.2.0",
    "@scure/bip32": "^1.4.0",
    "@scure/bip39": "^1.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.11.0",
    "esbuild": "^0.27.2",
    "jsdom": "^24.0.0",
    "playwright": "^1.40.0",
    "typescript": "^5.4.5",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
